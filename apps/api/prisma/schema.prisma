generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  ios
  android
}

enum Unit {
  un
  kg
  g
  l
  ml
}

enum StorageLocation {
  geladeira
  freezer
  armario
}

enum ProductStatus {
  active
  consumed
  discarded
}

enum AlertType {
  expiring_soon
  expired
}

enum RecipeSource {
  internal
  external
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  email            String   @unique
  passwordHash     String   @map("password_hash")
  timezone         String   @default("America/Sao_Paulo")
  notifyHour       Int      @default(9) @map("notify_hour") @db.SmallInt
  notifyDaysBefore Int      @default(3) @map("notify_days_before") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  categories    Category[]
  products      Product[]
  alerts        Alert[]
  recipes       Recipe[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   Platform
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Category {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String? @map("user_id") @db.Uuid // null = categoria global padrão
  name                 String
  icon                 String?
  defaultShelfLifeDays Int?    @map("default_shelf_life_days")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([userId])
  @@map("categories")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  categoryId   String?         @map("category_id") @db.Uuid
  name         String
  brand        String?
  barcode      String?
  quantity     Decimal         @default(1) @db.Decimal(10, 3)
  unit         Unit            @default(un)
  purchaseDate DateTime?       @map("purchase_date") @db.Date
  expiryDate   DateTime        @map("expiry_date") @db.Date
  location     StorageLocation @default(armario)
  status       ProductStatus   @default(active)
  notes        String?
  imageUrl     String?         @map("image_url")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  alerts   Alert[]

  @@index([userId, status, expiryDate])
  @@map("products")
}

model Alert {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  type         AlertType
  scheduledFor DateTime  @map("scheduled_for") @db.Date
  sentAt       DateTime? @map("sent_at")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Idempotência do cron: um alerta por produto/tipo/dia
  @@unique([productId, type, scheduledFor])
  @@index([userId, createdAt])
  @@map("alerts")
}

model Recipe {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid // null = receita global
  title        String
  instructions String
  imageUrl     String?      @map("image_url")
  prepMinutes  Int?         @map("prep_minutes")
  source       RecipeSource @default(internal)
  externalId   String?      @map("external_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id             String  @id @default(uuid()) @db.Uuid
  recipeId       String  @map("recipe_id") @db.Uuid
  ingredientName String  @map("ingredient_name") // normalizado (minúsculo, sem acento)
  quantity       Decimal? @db.Decimal(10, 3)
  unit           String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([ingredientName])
  @@map("recipe_ingredients")
}
