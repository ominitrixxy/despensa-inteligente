NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://despensa:despensa@localhost:5432/despensa?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=troque-este-segredo-em-producao
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# true = este processo executa o cron horario (use true em UM processo/worker apenas)
RUN_SCHEDULER=true

# Opcional: token de acesso do Expo para push (https://expo.dev/accounts/[conta]/settings/access-tokens)
EXPO_ACCESS_TOKEN=

# Opcional: chave da Spoonacular (fallback de receitas externas)
SPOONACULAR_API_KEY=
